# Local-only OpenSky OAuth2 credentials.
#
# 1. Log in at https://opensky-network.org
# 2. Create an API client on your Account page
# 3. Copy this file to `.env.local` and fill in the values
#
# Do NOT add the `VITE_` prefix. These values are read by the Vite dev server
# and injected into proxied requests; they must never reach the browser bundle.
#
# `.env.local` is gitignored.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Optional browser-safe overrides.
# `VITE_` values are bundled into the client: never put secrets here.
#
# Path prefix of the local OpenSky proxy (default: /opensky).
# VITE_OPENSKY_PROXY_URL=/opensky
#
# Default auto-refresh interval in ms, clamped to 15000-300000 (default: 30000).
# The in-app settings popover overrides this and is persisted in localStorage.
# VITE_DEFAULT_REFRESH_MS=30000
#
# Set to 1 to use deterministic mock aircraft for local failure testing.
# VITE_USE_MOCK=0
